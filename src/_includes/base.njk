<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {# Link preview card (Discord, social sites). #}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ title }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="The AA2 Depot logo over a pixel-art school at sunset.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#4a2d8c">
  <script>
    // Set the backdrop's hour and palette. Starts from the visitor's clock;
    // ?period=night etc. overrides it, and js/sky.js calls it while dragging.
    window.setSkyHour = (hour) => {
      const root = document.documentElement;
      root.style.setProperty("--hour", hour);
      root.dataset.period = hour < 5 || hour >= 19 ? "night"
        : hour < 10 ? "morning"
        : hour < 16 ? "day"
        : "evening";
    };
    (() => {
      const presets = { morning: 7.5, day: 12, evening: 17.5, night: 0 };
      const forced = new URLSearchParams(location.search).get("period");
      const now = new Date();
      setSkyHour(presets[forced] ?? now.getHours() + now.getMinutes() / 60);
    })();
  </script>
  <script src="/js/sky.js" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DotGothic16&family=M+PLUS+Rounded+1c:wght@800&display=swap">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/scene.css">
</head>
<body>
  {% include "scene.njk" %}

  {{ content | safe }}
</body>
</html>
